# ===== WordPress =====
WP_SITE_URL=https://blogif.in
WP_USERNAME=your_wp_username
# Application Password (from WP Admin > Users > Profile > Application Passwords)
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# ===== AI (Google Gemini - has free tier) =====
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# ===== Featured images (Pexels - free) =====
# Get from: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key

# ===== Posting behavior =====
NICHE=Career and Personal Finance for Young Indians
POST_STATUS=draft
# draft = safe (you review before publishing) - RECOMMENDED for AdSense
# publish = goes live immediately
DEFAULT_AUTHOR_ID=1
DEFAULT_CATEGORY=General
